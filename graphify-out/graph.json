      "norm_label": "amp float16 inference"
    },
    {
      "label": "Pinned Memory + non_blocking DMA",
      "file_type": "rationale",
      "source_file": "PERFORMANCE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "pin_memory() + .to(device, non_blocking=True) overlaps CPU->GPU transfers with compute.",
      "id": "rationale_pinned_memory",
      "community": 4,
      "norm_label": "pinned memory + non_blocking dma"
    },
    {
      "label": "Avoid torch.compile (Mask R-CNN incompatible)",
      "file_type": "rationale",
      "source_file": "PERFORMANCE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Dynamic proposal counts + Tensor.item() graph breaks cause recompilation storms making compiled mode ~10x slower. The plan proposed torch.compile; PERFORMANCE.md documents reverting it.",
      "id": "rationale_no_torch_compile",
      "community": 2,
      "norm_label": "avoid torch.compile (mask r-cnn incompatible)"
    },
    {
      "label": "cuDNN Warmup Pass",
      "file_type": "rationale",
      "source_file": "PERFORMANCE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A startup warm-up batch at real image dims forces cuDNN autotuning so the first user request is not slow.",
      "id": "rationale_cudnn_warmup",
      "community": 2,
      "norm_label": "cudnn warmup pass"
    },
    {
